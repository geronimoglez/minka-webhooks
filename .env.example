# Copy to .env.local for `vercel dev`. Set in Vercel dashboard for prod.
#
# GHL purgado 2026-07-16 (decisión Gerónimo): se salió de GoHighLevel. Las vars GHL_*,
# WEBHOOK_SHARED_SECRET, NOTION_* y OPENCLAW_* ya no las usa ningún endpoint (vivían en el
# webhook /api/ghl, ahora borrado) → BÓRRALAS del env de Vercel. El PIT token GHL, además,
# conviene REVOCARLO en GoHighLevel (daba acceso a la cuenta con los leads).

# --- Telegram (avisos internos a Gerónimo) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM del diagnóstico P0 (/api/diagnostico) ---
OPENROUTER_API_KEY=
# DIAGNOSTICO_MODEL=xiaomi/mimo-v2.5-pro   # opcional; default en código

# --- CRM: Odoo (JSON-RPC) — usado por diagnostico / onboarding / portal-status vía lib/crm.js ---
# Driver auto: si ODOO_URL+ODOO_DB+ODOO_API_KEY están set → "odoo"; si no → "none" (degrada honesto).
# CRM_DRIVER=odoo            # opcional; fuerza el driver ("odoo" | "none")
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
# Wake-retry para el cold-start de Railway (opcionales; defaults sensatos en lib/crm.js):
# ODOO_WAKE_RETRIES=2
# ODOO_WAKE_BACKOFF_MS=1500
# ODOO_WAKE_MAX_MS=6000

# --- CRM multi-tenant: una base de Odoo por cliente ---
# lib/crm.js acepta un `tenant` opcional. Sin tenant usa las ODOO_* de arriba (el CRM de Minka);
# con tenant "juanelo" usa estas otras. NO hay fallback: si faltan, el endpoint degrada a driver
# "none" en vez de escribir los datos de un cliente en la base de otro.
ODOO_URL_JUANELO=https://juanelo.crm.minkadigital.com
ODOO_DB_JUANELO=juanelo
ODOO_USER_JUANELO=
ODOO_API_KEY_JUANELO=

# --- Embudo de postulación: Íconos de la Belleza · Carreras de Éxito IV (cliente Juanelo) ---
# Rutas (expuestas same-origin desde carrerasdeexito.com por rewrite):
#   /postulacion  /postulacion/gracias  /postulacion/pago  /postulacion/pagado  /postulacion/documentos
#
# Secreto para firmar el token que liga la pantalla de gracias con el lead ya creado. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Fail-closed: sin él la pantalla de gracias no puede cobrar y degrada a WhatsApp.
POSTULACION_TOKEN_SECRET=

EVENTO_CRM_TENANT=juanelo
EVENTO_APARTADO_MXN=100          # apartado en pesos enteros; Juanelo puede subirlo sin tocar código
EVENTO_EXTRA_TEQUILA_MXN=1000    # extra opcional del domingo (ya confirmado y publicado)
EVENTO_LUGARES=50
EVENTO_WHATSAPP=523314192737
EVENTO_ORIGIN=https://carrerasdeexito.com
# Pendientes de Juanelo: mientras estén vacíos la página dice "por confirmar" en vez de inventar.
EVENTO_FECHA_SEDE=
EVENTO_PRECIO_PASE=
EVENTO_TIEMPO_RESPUESTA=

# --- Stripe (cuenta de MINKA — el cargo aparece a nombre de la agencia) ---
# Llave secreta: sk_test_… en pruebas, sk_live_… en producción. lib/stripe.js deduce el modo de la
# propia llave y rechaza una sesión cuyo livemode no corresponda.
STRIPE_SECRET_KEY=
# Secreto propio del webhook, en la URL. Fail-closed: sin esto el endpoint responde 401 a todo.
# En Stripe se registra el endpoint como:
#   https://minka-webhooks.vercel.app/api/stripe-webhook?k=<STRIPE_WEBHOOK_URL_SECRET>
# Eventos: checkout.session.completed y checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_URL_SECRET=
