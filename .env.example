# Copy to .env.local for `vercel dev`. Set in Vercel dashboard for prod.
#
# GHL purgado 2026-07-16 (decisión Gerónimo): se salió de GoHighLevel. Las vars GHL_*,
# WEBHOOK_SHARED_SECRET, NOTION_* y OPENCLAW_* ya no las usa ningún endpoint (vivían en el
# webhook /api/ghl, ahora borrado) → BÓRRALAS del env de Vercel. El PIT token GHL, además,
# conviene REVOCARLO en GoHighLevel (daba acceso a la cuenta con los leads).

# --- Telegram (avisos internos a Gerónimo) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM del diagnóstico P0 (/api/diagnostico) ---
OPENROUTER_API_KEY=
# Todas opcionales; los defaults viven en api/diagnostico.js.
# DIAGNOSTICO_MODEL=xiaomi/mimo-v2.5-pro
# DIAGNOSTICO_MODEL_FALLBACK=deepseek/deepseek-v4-pro  # se usa si el primario falla 2 veces seguidas
# DIAGNOSTICO_RL_MAX=15   # diagnósticos/hora/IP (1-200). Subir en un pico viral: el CGNAT de Telcel
                          # hace que muchos móviles compartan la misma IP pública.

# --- Correo del diagnóstico AL PROSPECTO (FASE 2) ---
# Sale desde ODOO (mail.mail + addon minka_ses → AWS SES), el mismo camino que ya usa
# scripts/p0_nurture.py del repo principal: NO hace falta ninguna credencial de correo aquí, basta
# con que las ODOO_* de abajo estén puestas. Todas opcionales; defaults en api/diagnostico.js.
# DIAGNOSTICO_MAIL_SEND=0   # kill-switch: apaga SÓLO el correo al prospecto (default: encendido)
# DIAGNOSTICO_MAIL_FROM=    # vacío = el remitente que Odoo ya tiene configurado
                            # (noreply@minkadigital.com). ⚠️ NO poner otra dirección sin verificarla
                            # antes como identidad en AWS SES: SES rechaza el envío completo si la
                            # Source no es suya, y nos quedaríamos otra vez sin mandar el diagnóstico.
# DIAGNOSTICO_MAIL_REPLY_TO=hola@minkadigital.com   # a dónde caen las respuestas (no toca la reputación)

# --- CRM: Odoo (JSON-RPC) — usado por diagnostico / onboarding / portal-status vía lib/crm.js ---
# Driver auto: si ODOO_URL+ODOO_DB+ODOO_API_KEY están set → "odoo"; si no → "none" (degrada honesto).
# CRM_DRIVER=odoo            # opcional; fuerza el driver ("odoo" | "none")
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
# Wake-retry para el cold-start de Railway (opcionales; defaults sensatos en lib/crm.js):
# ODOO_WAKE_RETRIES=2
# ODOO_WAKE_BACKOFF_MS=1500
# ODOO_WAKE_MAX_MS=6000

# --- Copiloto de comentarios de Instagram (/api/ig-comments + /api/ig-accion) ---
# App `minka-assistant` en Meta, Development Mode. @minka.one es cuenta propia → NO requiere
# App Review. Para moderar cuentas de CLIENTES sí: Advanced Access (Business Verification +
# App Review, 2-4 semanas).
IG_ACCESS_TOKEN=          # el mismo que ya usa scripts/ig_publish.py del repo principal
IG_APP_SECRET=            # Meta → tu app → Instagram → "Clave secreta de la app de Instagram"
IG_VERIFY_TOKEN=          # inventa una cadena; la misma va en el campo "Token de verificación"
TELEGRAM_WEBHOOK_SECRET=  # inventa otra; va en setWebhook como secret_token
COPILOTO_BOT_TOKEN=       # bot PROPIO del copiloto (NO el del Director: ése corre en Railway
                          # por long polling y Telegram no admite polling + webhook en el mismo
                          # token — registrarle un webhook lo dejaría sordo en producción)
# IG_COPILOTO_MODEL=deepseek/deepseek-v4-flash   # clasificar es clasificación, no razonamiento
